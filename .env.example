# Crystal Projects Visualization Docker Configuration
# Copy this file to .env and customize for your environment

# GitHub Configuration
# GitHub username to scan Crystal repositories for
GITHUB_USER=ralsina

# Data Collection Settings
# Maximum recursion depth for dependency scanning
MAX_DEPTH=3

# Maximum number of projects to process
MAX_PROJECTS=500

# Delay between GitHub API calls in seconds (rate limiting)
RATE_LIMIT_DELAY=0.1

# Output file path for project data
DATA_FILE=/app/public/projects.json

# Web Server Port
PORT=3000