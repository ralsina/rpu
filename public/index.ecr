<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ralsina's Crystal Projects Visualization</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
    <script src="https://d3js.org/d3.v7.min.js"></script>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, sans-serif;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem;
            text-align: center;
        }

        .header h1 {
            margin: 0;
            font-size: 2.5rem;
        }

        .header p {
            margin: 0.5rem 0 0 0;
            opacity: 0.9;
        }

        .visualization {
            width: 100%;
            height: 80vh;
            border: 1px solid #dee2e6;
            background: #f8f9fa;
        }

        .tooltip {
            position: absolute;
            padding: 10px;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            border-radius: 4px;
            font-size: 12px;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .controls {
            padding: 1rem;
            background: #e9ecef;
            display: flex;
            gap: 1rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .legend {
            display: flex;
            gap: 2rem;
            align-items: center;
            margin-left: auto;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.9rem;
        }

        .legend-color {
            width: 16px;
            height: 16px;
            border-radius: 50%;
        }

        .stats {
            padding: 1rem;
            background: #f8f9fa;
            border-top: 1px solid #dee2e6;
            display: flex;
            justify-content: center;
            gap: 3rem;
            flex-wrap: wrap;
        }

        .stat {
            text-align: center;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: bold;
            color: #495057;
        }

        .stat-label {
            font-size: 0.9rem;
            color: #6c757d;
        }

        @media (max-width: 768px) {
            .header h1 {
                font-size: 1.8rem;
            }

            .legend {
                margin-left: 0;
                margin-top: 1rem;
            }

            .stats {
                gap: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>🔮 Crystal Projects Visualization</h1>
        <p>Interactive dependency graph of ralsina's Crystal projects</p>
    </div>

    <div class="controls">
        <button onclick="resetZoom()">🔄 Reset Zoom</button>
        <button onclick="toggleLabels()">🏷️ Toggle Labels</button>
        <div class="legend">
            <div class="legend-item">
                <div style="width: 16px; height: 16px; border-radius: 50%; border: 2px solid #333; background: #4ade80;"></div>
                <span>Original Project</span>
            </div>
            <div class="legend-item">
                <svg width="16" height="16" viewBox="-8 -8 16 16">
                    <polygon points="4,0 2,3.46 -2,3.46 -4,0 -2,-3.46 2,-3.46"
                             fill="#4ade80" stroke="#ff6b35" stroke-width="1.5"/>
                </svg>
                <span>Forked Project</span>
            </div>
            <div class="legend-item">
                <svg width="16" height="16" viewBox="-8 -8 16 16">
                    <polygon points="0,-6 5.2,3 -5.2,3"
                             fill="#e8f4fd" stroke="#2196f3" stroke-width="1.5"/>
                </svg>
                <span>External Dependency</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #4ade80;"></div>
                <span>Last month</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #a3e635;"></div>
                <span>3 months</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #fbbf24;"></div>
                <span>6 months</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #fb923c;"></div>
                <span>1 year</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #ef4444;"></div>
                <span>1+ year</span>
            </div>
        </div>
    </div>

    <div class="visualization" id="graph"></div>

    <div class="tooltip" id="tooltip"></div>

    <div class="stats">
        <div class="stat">
            <div class="stat-value" id="project-count">-</div>
            <div class="stat-label">Projects</div>
        </div>
        <div class="stat">
            <div class="stat-value" id="total-loc">-</div>
            <div class="stat-label">Total LOC</div>
        </div>
        <div class="stat">
            <div class="stat-value" id="dependency-count">-</div>
            <div class="stat-label">Dependencies</div>
        </div>
    </div>

    <script>
        let data;
        let simulation;
        let svg, g, link, node;
        let labelsVisible = true;

        // Load data
        fetch('/projects.json')
            .then(response => response.json())
            .then(d => {
                data = process_data(d);
                update_stats(d);
                create_visualization();
            })
            .catch(error => {
                console.error('Error loading data:', error);
                document.getElementById('graph').innerHTML =
                    '<div style="padding: 2rem; text-align: center; color: #dc3545;">Failed to load project data. Make sure the data collection script has been run.</div>';
            });

        function process_data(projects) {
            const nodes = projects.map(p => ({
                id: p.name,
                name: p.name,
                loc: p.loc,
                description: p.description,
                url: p.url,
                last_modified: p.last_modified,
                dependencies: p.dependencies,
                external_dependencies: p.external_dependencies || [],
                fork: p.fork || false,
                external: p.external || false
            }));

            const links = [];
            nodes.forEach(node => {
                // Add internal dependency links
                node.dependencies.forEach(dep => {
                    const target = nodes.find(n => n.name === dep);
                    if (target) {
                        links.push({
                            source: node.name,
                            target: target.name,
                            type: 'internal'
                        });
                    }
                });

                // Add external dependency links
                node.external_dependencies.forEach(dep => {
                    const target = nodes.find(n => n.name === dep);
                    if (target) {
                        links.push({
                            source: node.name,
                            target: target.name,
                            type: 'external'
                        });
                    }
                });
            });

            return { nodes, links };
        }

        function update_stats(projects) {
            document.getElementById('project-count').textContent = projects.length;

            const totalLoc = projects.reduce((sum, p) => sum + p.loc, 0);
            document.getElementById('total-loc').textContent = totalLoc.toLocaleString();

            const totalDeps = projects.reduce((sum, p) => sum + p.dependencies.length, 0);
            document.getElementById('dependency-count').textContent = totalDeps;
        }

        function create_visualization() {
            const container = document.getElementById('graph');
            const width = container.clientWidth;
            const height = container.clientHeight;

            svg = d3.select('#graph')
                .append('svg')
                .attr('width', width)
                .attr('height', height);

            g = svg.append('g');

            // Add zoom behavior
            const zoom = d3.zoom()
                .scaleExtent([0.1, 4])
                .on('zoom', (event) => {
                    g.attr('transform', event.transform);
                });

            svg.call(zoom);

            // Color scale for activity (green for recent, red for old)
            const now = new Date();
            const oneYearAgo = new Date(now.getTime() - (365 * 24 * 60 * 60 * 1000));
            const oneMonthAgo = new Date(now.getTime() - (30 * 24 * 60 * 60 * 1000));

            // Create a custom green-to-red gradient
            const colorScale = (lastModified) => {
                if (!lastModified) return '#ffcccc'; // Light red for no date

                const date = new Date(lastModified);
                const diffDays = (now - date) / (1000 * 60 * 60 * 24);

                if (diffDays <= 30) {
                    // Green for last month
                    return '#4ade80';
                } else if (diffDays <= 90) {
                    // Yellow-green for 3 months
                    return '#a3e635';
                } else if (diffDays <= 180) {
                    // Yellow for 6 months
                    return '#fbbf24';
                } else if (diffDays <= 365) {
                    // Orange for year
                    return '#fb923c';
                } else {
                    // Red for over a year
                    return '#ef4444';
                }
            };

            // Size scale for LOC with min/max constraints
            const maxLoc = d3.max(data.nodes, d => d.loc) || 1000;
            const minNodeSize = 20;  // Minimum node radius
            const maxNodeSize = 40;  // Maximum node radius
            const sizeScale = d3.scaleSqrt()
                .domain([0, maxLoc])
                .range([minNodeSize, maxNodeSize]);

            // Create links
            link = g.append('g')
                .selectAll('line')
                .data(data.links)
                .enter().append('line')
                .attr('stroke', d => d.type === 'external' ? '#2196f3' : '#999')  // Blue for external, gray for internal
                .attr('stroke-opacity', d => d.type === 'external' ? 0.8 : 0.6)
                .attr('stroke-width', d => d.type === 'external' ? 1.5 : 2)
                .attr('stroke-dasharray', d => d.type === 'external' ? '5,5' : '0')  // Dashed for external
                            .attr('marker-end', d => d.type === 'external' ? 'url(#arrowhead-external)' : 'url(#arrowhead)');

            // Add arrow markers for dependency links
            const defs = svg.append('defs');

            // Internal dependency arrow marker (gray, smaller)
            defs.append('marker')
                .attr('id', 'arrowhead')
                .attr('viewBox', '0 0 10 10')
                .attr('refX', 15)
                .attr('refY', 3)
                .attr('markerWidth', 6)
                .attr('markerHeight', 6)
                .attr('orient', 'auto')
                .append('path')
                .attr('d', 'M0,0 L0,6 L9,3 z')
                .attr('fill', '#999')
                .attr('opacity', 0.6);

            // External dependency arrow marker (blue, smaller)
            defs.append('marker')
                .attr('id', 'arrowhead-external')
                .attr('viewBox', '0 0 10 10')
                .attr('refX', 15)
                .attr('refY', 3)
                .attr('markerWidth', 6)
                .attr('markerHeight', 6)
                .attr('orient', 'auto')
                .append('path')
                .attr('d', 'M0,0 L0,6 L9,3 z')
                .attr('fill', '#2196f3')
                .attr('opacity', 0.6);

            // Helper function to create hexagon points
            function createHexagonPoints(radius) {
                const points = [];
                for (let i = 0; i < 6; i++) {
                    const angle = (Math.PI / 3) * i - Math.PI / 6;
                    points.push([radius * Math.cos(angle), radius * Math.sin(angle)]);
                }
                return points;
            }

            // Create nodes - circles for original, hexagons for forks
            node = g.append('g')
                .selectAll('.node')
                .data(data.nodes)
                .enter().append('g')
                .attr('class', 'node')
                .style('cursor', 'pointer')
                .on('mouseover', show_tooltip)
                .on('mouseout', hide_tooltip)
                .on('click', (event, d) => {
                    window.open(d.url, '_blank');
                });

            // Function to calculate font size based on node radius and text length
            const calculateFontSize = (nodeRadius, textLength) => {
                const maxRadius = maxNodeSize;
                const minRadius = minNodeSize;

                // Base font size calculation (smaller for longer text)
                let fontSize = Math.min(14, Math.max(8, (nodeRadius * 2) / Math.sqrt(textLength)));

                // Scale with node size
                fontSize = fontSize * (nodeRadius / maxRadius);

                return fontSize;
            };

            // Add circles for original projects
            node.filter(d => !d.fork && !d.external)
                .append('circle')
                .attr('r', d => sizeScale(d.loc))
                .attr('fill', d => d.last_modified ? colorScale(d.last_modified) : '#ffcccc')
                .attr('stroke', '#333')
                .attr('stroke-width', 2);

            // Add hexagons for forked projects
            node.filter(d => d.fork && !d.external)
                .append('polygon')
                .attr('points', d => createHexagonPoints(sizeScale(d.loc)).map(p => p.join(',')).join(' '))
                .attr('fill', d => d.last_modified ? colorScale(d.last_modified) : '#ffcccc')
                .attr('stroke', '#ff6b35')  // Orange stroke for forks
                .attr('stroke-width', 2);

            // Add triangles for external dependencies (50% larger)
            node.filter(d => d.external)
                .append('polygon')
                .attr('points', '0,-12 10.4,6 -10.4,6')  // 50% larger triangle
                .attr('fill', '#e8f4fd')
                .attr('stroke', '#2196f3')  // Blue stroke for external deps
                .attr('stroke-width', 2);

            // Create labels that fit inside nodes
            const label = node.append('text')
                .text(d => {
                    // Truncate long names for better fit
                    const maxLength = d.external ? 8 : 12;
                    return d.name.length > maxLength ? d.name.substring(0, maxLength - 2) + '...' : d.name;
                })
                .style('font-size', d => {
                    const radius = d.external ? 12 : sizeScale(d.loc);  // Larger radius for 50% bigger triangles
                    return calculateFontSize(radius, d.name.length) + 'px';
                })
                .style('font-weight', 'bold')
                .style('fill', '#fff')
                .style('pointer-events', 'none')
                .attr('text-anchor', 'middle')
                .attr('dominant-baseline', 'central')
                .attr('dy', 0)
                .style('text-shadow', '1px 1px 2px rgba(0,0,0,0.7)');

            // Create force simulation with better constraints
            simulation = d3.forceSimulation(data.nodes)
                .force('link', d3.forceLink(data.links).id(d => d.name).distance(120))
                .force('charge', d3.forceManyBody().strength(-200))
                .force('center', d3.forceCenter(width / 2, height / 2).strength(0.1))
                .force('collision', d3.forceCollide().radius(d => {
                    if (d.external) return 15;  // Larger collision for 50% bigger triangles
                    return sizeScale(d.loc) + 5;
                }))
                .force('x', d3.forceX(width / 2).strength(0.1))
                .force('y', d3.forceY(height / 2).strength(0.1))
                .alphaDecay(0.05)  // Slower alpha decay for better positioning
                .velocityDecay(0.3);  // Higher velocity decay for stability

            simulation.on('tick', () => {
                link
                    .attr('x1', d => d.source.x)
                    .attr('y1', d => d.source.y)
                    .attr('x2', d => d.target.x)
                    .attr('y2', d => d.target.y);

                node
                    .attr('transform', d => `translate(${d.x},${d.y})`);
            });
        }

        function show_tooltip(event, d) {
            const tooltip = document.getElementById('tooltip');
            const lastMod = d.last_modified ? new Date(d.last_modified).toLocaleDateString() : 'Unknown';

            let status = '';
            if (d.external) {
                status = '🔷 External Dependency';
            } else if (d.fork) {
                status = '🔄 Forked Project';
            } else {
                status = '✨ Original Project';
            }

            // Calculate activity status
            let activityStatus = '';
            let activityEmoji = '';
            if (!d.external && d.last_modified) {
                const now = new Date();
                const date = new Date(d.last_modified);
                const diffDays = (now - date) / (1000 * 60 * 60 * 24);

                if (diffDays <= 30) {
                    activityStatus = '🟢 Active (last month)';
                    activityEmoji = '🟢';
                } else if (diffDays <= 90) {
                    activityStatus = '🟡 Recently active (3 months)';
                    activityEmoji = '🟡';
                } else if (diffDays <= 180) {
                    activityStatus = '🟠 Moderate (6 months)';
                    activityEmoji = '🟠';
                } else if (diffDays <= 365) {
                    activityStatus = '🔶 Inactive (1 year)';
                    activityEmoji = '🔶';
                } else {
                    activityStatus = '🔴 Stale (1+ year)';
                    activityEmoji = '🔴';
                }
            }

            const internalDeps = d.dependencies.length;
            const externalDeps = d.external_dependencies ? d.external_dependencies.length : 0;

            tooltip.innerHTML = `
                <strong>${d.name}</strong> ${status}<br>
                ${d.description || 'No description'}<br>
                ${!d.external ? `<strong>LOC:</strong> ${d.loc.toLocaleString()}<br>` : ''}
                ${!d.external ? `<strong>Activity:</strong> ${activityStatus}<br>` : ''}
                ${!d.external ? `<strong>Internal deps:</strong> ${internalDeps}<br>` : ''}
                ${!d.external && externalDeps > 0 ? `<strong>External deps:</strong> ${externalDeps}<br>` : ''}
                ${!d.external ? `<strong>Last modified:</strong> ${lastMod}<br>` : ''}
                <em>${d.external ? 'External Crystal shard' : 'Click to open repository'}</em>
            `;

            tooltip.style.left = event.pageX + 10 + 'px';
            tooltip.style.top = event.pageY - 10 + 'px';
            tooltip.style.opacity = 1;
        }

        function hide_tooltip() {
            document.getElementById('tooltip').style.opacity = 0;
        }

        function resetZoom() {
            svg.transition().duration(750).call(
                d3.zoom().transform,
                d3.zoomIdentity
            );
        }

        function toggleLabels() {
            labelsVisible = !labelsVisible;
            g.selectAll('text')
                .transition()
                .duration(300)
                .style('opacity', labelsVisible ? 1 : 0);
        }

        // Handle window resize
        window.addEventListener('resize', () => {
            const container = document.getElementById('graph');
            const width = container.clientWidth;
            const height = container.clientHeight;

            svg.attr('width', width).attr('height', height);

            if (simulation) {
                simulation.force('center', d3.forceCenter(width / 2, height / 2));
                simulation.alpha(0.3).restart();
            }
        });
    </script>
</body>
</html>